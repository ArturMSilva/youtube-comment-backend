{
  "builds": [
    {
      "src": "api/ask.ts",
      "use": "@vercel/node",
      "config": {
        "memory": 256,
        "maxDuration": 30
      }
    },
    {
      "src": "api/comments.ts",
      "use": "@vercel/node",
      "config": {
        "memory": 256,
        "maxDuration": 30
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/ask",
      "dest": "/api/ask.ts"
    },
    {
      "src": "/api/comments",
      "dest": "/api/comments.ts"
    },
    {
      "src": "/politica/?",
      "dest": "/public/politica-de-privacidade.html"
    },
    {
      "src": "/politica-de-privacidade.html",
      "dest": "/public/politica-de-privacidade.html"
    }
  ]
}
